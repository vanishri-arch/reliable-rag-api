# Required for generated answers; ingestion and retrieval can be explored without it.
OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-4o-mini

# Embeddings run locally; first startup downloads this model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.25
